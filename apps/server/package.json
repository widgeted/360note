    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.3.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
