# 360note production environment
# Install at /etc/360note/360note.env, chmod 600, chown root:root
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
PUBLIC_ORIGIN=https://360note.com

# PostgreSQL
DATABASE_URL=postgres://360note:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:5432/360note

# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS
# Generate 32 random bytes, base64: openssl rand -base64 32
# Losing this key makes encrypted attachments and backups unreadable.
NOTE360_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES

NOTE360_DATA_DIR=/var/lib/360note
WEB_DIST=/opt/360note/apps/web/dist
NOTE360_ENV_FILE=/etc/360note/360note.env

# open | invite
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=

# Optional
OCR_ENABLED=true
MAX_UPLOAD_BYTES=26214400
BACKUP_RETENTION_DAYS=30
SESSION_DAYS=30
TRUST_PROXY=127.0.0.1

# Outgoing mail (registration and password-reset verification codes).
# The default below matches the NameCrane / SmarterMail service used by
# 360note.com (eu1.workspace.org, SMTPS on 465). Any standard SMTP provider works.
SMTP_HOST=eu1.workspace.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@360note.com
SMTP_PASS=REPLACE_WITH_MAIL_PASSWORD
MAIL_FROM=noreply@360note.com
MAIL_FROM_NAME=360note

# AI is off by default. Prefer configuring it in the admin UI so keys are encrypted in DB.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
